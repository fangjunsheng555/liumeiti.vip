# ===============================================================
# 冒央会社 / Maoyang Taiwan Inc - Environment Variables
# ===============================================================

# ─── Telegram bot order push (REQUIRED for order submission) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── USDT TRC20 automatic receipt confirmation (optional) ───
# TronGrid works without a key at low volume; a key is recommended in production.
TRONGRID_API_KEY=
# Required when /api/admin/usdt-check is invoked by Vercel Cron or another scheduler.
# Vercel sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Authenticated maintenance dispatcher. Keep enabled in production; GitHub
# Actions calls /api/cron/maintenance once per hour and Vercel keeps a daily
# fallback run on the Hobby plan. The historical HIGH_FREQUENCY name now means
# "external hourly scheduler active"; it selects the 1 h / 2.5 h health policy.
MAINTENANCE_CRON_ENABLED=1
OPS_HIGH_FREQUENCY_CRON=1
OPS_MISSED_JOB_ALERTS=1
# Optional. System-health incident lifecycle messages are disabled by default
# to avoid sending cron/API health noise to the business Telegram channel.
# Set to 1 only when open/reopened/recovered incident alerts are explicitly wanted.
# Order, after-sales, withdrawal and security notifications are unaffected.
OPS_INCIDENT_TELEGRAM_ENABLED=0

# ─── Order storage (Vercel KV / Upstash Redis - REQUIRED for order query) ───
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Resend email delivery (REQUIRED for site email sending) ───
# Create an API key in Resend after verifying liumeiti.vip.
RESEND_API_KEY=
# Resend dashboard Webhook endpoint: https://www.liumeiti.vip/api/webhooks/resend
# Subscribe to sent/delivered/delayed/bounced/complained/failed/suppressed/opened/clicked.
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=resend
MAIL_FROM=info@liumeiti.vip
MAIL_FROM_NAME=冒央会社
ENABLE_EMAIL_TEST=false

# ─── Marketing consent, one-click unsubscribe and attribution (REQUIRED when sending marketing mail) ───
# Independent random value (32+ characters). In production there is no
# AUTH_SECRET fallback, so missing configuration fails closed.
MAIL_PREFERENCES_SECRET=

# Legacy SMTP is disabled unless EMAIL_PROVIDER is explicitly changed to smtp.

# ─── Resend SMTP settings (used when EMAIL_PROVIDER=smtp) ───
# Password is the Resend API key. Do not commit it.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=info@liumeiti.vip

# ─── Brevo emergency SMTP fallback (transactional mail only) ───
# Used only when Resend explicitly reports a daily/monthly quota error.
FALLBACK_SMTP_PROVIDER=brevo
FALLBACK_SMTP_HOST=smtp-relay.brevo.com
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_USER=
FALLBACK_SMTP_PASS=
FALLBACK_SMTP_FROM=info@liumeiti.vip
# Brevo transactional webhook:
# https://www.liumeiti.vip/api/webhooks/brevo?token=<BREVO_WEBHOOK_TOKEN>
BREVO_WEBHOOK_TOKEN=

# ─── Browser Push (optional; all values are required when PUSH_ENABLED=true) ───
PUSH_ENABLED=false
# Generate this VAPID key pair once and keep it stable. Rotating it requires
# every browser to subscribe again.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:info@liumeiti.vip
# Two independent random values of at least 32 characters. Rotating the
# encryption key invalidates stored subscriptions; rotating the HMAC key
# detaches existing subscriptions from accounts.
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
PUSH_ACCOUNT_HMAC_SECRET=
# Optional comma-separated extension to the built-in Mozilla/Google/Apple
# push endpoint allowlist.
WEB_PUSH_ALLOWED_HOSTS=

# ─── Netflix self-service sign-in code inbox (optional) ───
# Cloudflare Email Worker posts raw MIME to /api/webhooks/netflix-email.
# Both secrets must be independent random values with at least 32 characters.
NETFLIX_EMAIL_INGEST_SECRET=
NETFLIX_CODE_ENCRYPTION_KEY=
NETFLIX_INBOX_ADDRESS=netflix@codes.liumeiti.vip
# Worker-side (set in Cloudflare, not here): FALLBACK_FORWARD_ADDRESS may name a
# verified Email Routing destination; failed ingests forward there instead of
# bouncing back to the customer mailbox.

# ─── Branding (optional - defaults shown) ───
BRAND_NAME=冒央会社
SITE_DOMAIN=liumeiti.vip
SUPPORT_CONTACT=请通过 QQ 2802632995 / WhatsApp +1 4315093334 / Telegram @MaoyangSupport 联系在线客服

# ─── Admin dashboard (REQUIRED for /admin) ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── User auth (REQUIRED for register/login) — random 32+ chars ───
AUTH_SECRET=
# Temporary migration window for pre-v2 user cookies. Set one immutable,
# absolute ISO-8601 deadline before the first production deployment; do not
# calculate it from request time or move it on later deploys. This value takes
# precedence over LEGACY_USER_SESSION_DEPLOYED_AT and the Redis anchor.
LEGACY_USER_SESSION_UNTIL=
# Optional deployment-time alternative: an absolute ISO-8601 timestamp for
# the first v2 deployment. The server derives one fixed 14-day deadline from
# it. Leave empty when LEGACY_USER_SESSION_UNTIL is configured.
LEGACY_USER_SESSION_DEPLOYED_AT=

# ─── Google OAuth login (optional) ───
# SITE_URL must match the production domain, for example https://liumeiti.vip
SITE_URL=https://liumeiti.vip
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Webhook (optional - alternative to Telegram) ───
# No default. When empty the site relies on Telegram push only.
ORDER_WEBHOOK_URL=

# ─── SMTP2GO delivery webhook (REQUIRED once SMTP2GO is connected) ───
# Without this value /api/webhooks/smtp2go answers 503 and every delivery,
# bounce and complaint event is dropped silently.
SMTP2GO_WEBHOOK_TOKEN=

# ─── Admin two-factor emergency bypass (leave empty in production) ───
# ADMIN_2FA_DISABLE=1 globally skips admin TOTP. It exists so a lost phone
# cannot lock the owner out. While active the admin Security panel shows a
# permanent warning banner. Never leave it set after recovery.
ADMIN_2FA_DISABLE=
# Legacy alias still accepted for ADMIN_USERNAME.
ADMIN_USER=

# ─── Support channels (optional - shown in emails and order pages) ───
# SUPPORT_CONTACT above is the Chinese text; this is its English counterpart.
SUPPORT_CONTACT_EN=
SUPPORT_QQ=
SUPPORT_WHATSAPP=
SUPPORT_TELEGRAM=

# ─── Diagnostics (keep disabled in production) ───
# Enables /api/test-email. Any value other than an explicit opt-in keeps it off.
ENABLE_SMTP_TEST=

# ─── Companion tool site at tool.liumeiti.vip (optional) ───
# Extra allowed CORS origin for /api/tool/* and the shared account endpoints.
TOOL_ORIGIN=
# Encrypts tool-side stored data. Required only when the tool site is used.
TOOL_DATA_KEY=
# Public site URL used to build OAuth redirect targets. Falls back to SITE_URL.
NEXT_PUBLIC_SITE_URL=
# Legacy alias still accepted for AUTH_SECRET.
SESSION_SECRET=
# Destination for tool feedback submissions. Falls back to MAIL_FROM.
FEEDBACK_TO=

# ─── Upstash Redis (optional aliases for KV_REST_API_* above) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── AI chat tool (optional; all values have built-in defaults) ───
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
CHAT_DAILY_LIMIT=
CHAT_IP_DAILY_LIMIT=
CHAT_MAX_TOKENS=
CHAT_MAX_TOKENS_UNLIMITED=
CHAT_WEB_SEARCH_MAX_USES=

# ─── AI image tool (optional; all values have built-in defaults) ───
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=
IMAGE_DAILY_LIMIT=
IMAGE_IP_DAILY_LIMIT=
